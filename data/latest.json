import json
import os
from datetime import datetime

def generar_resumen(archivo_json):
    # Verificamos que el archivo exista
    if not os.path.exists(archivo_json):
        print(f"Che, no encontré el archivo {archivo_json}.")
        return

    with open(archivo_json, 'r', encoding='utf-8') as f:
        try:
            contenido = json.load(f)
        except json.JSONDecodeError:
            print("Hubo un error al leer el JSON. Fijate si está bien formateado.")
            return

    # Adaptamos para que lea si es una lista (varias llamadas del cron) o un diccionario
    if isinstance(contenido, dict):
        registros = [contenido]
    elif isinstance(contenido, list):
        registros = contenido
    else:
        print("El formato del JSON no es ni lista ni diccionario.")
        return

    fechas = set() # Usamos un set para limpiar duplicados si el cronjob solapó datos

    # Recorremos cada respuesta de la API guardada
    for registro in registros:
        # Validamos que sea un diccionario y que el código de la API sea 0 (éxito)
        if not isinstance(registro, dict) or registro.get("code") != 0:
            continue

        datos = registro.get("data", {})
        
        # Usamos outdoor.temperature como referencia para sacar todos los timestamps
        temp_data = datos.get("outdoor", {}).get("temperature", {}).get("list", {})
        
        for timestamp in temp_data.keys():
            fechas.add(timestamp)

    if not fechas:
        print("No se encontraron datos en el archivo para armar el resumen.")
        return

    # Ordenamos las fechas cronológicamente
    fechas_ordenadas = sorted(list(fechas))
    
    # Convertimos a objetos datetime para poder calcular las diferencias
    formato_fecha = "%Y-%m-%d %H:%M:%S"
    fechas_dt = [datetime.strptime(f, formato_fecha) for f in fechas_ordenadas]

    total_registros = len(fechas_dt)
    inicio = fechas_ordenadas[0]
    fin = fechas_ordenadas[-1]

    # Imprimimos la cabecera del resumen
    print(f"--- Resumen Mensual de {archivo_json} ---")
    print(f"Total de mediciones únicas: {total_registros}")
    print(f"Primer registro: {inicio}")
    print(f"Último registro: {fin}")
    print("\n--- Verificación de intervalos de 5 minutos ---")

    huecos = 0
    # Chequeamos la diferencia de tiempo entre cada registro y el anterior
    for i in range(1, total_registros):
        delta = fechas_dt[i] - fechas_dt[i-1]
        minutos_diff = delta.total_seconds() / 60.0
        
        # Le damos un margen mínimo por si la API o el sensor tardaron unos segundos más (> 6 minutos)
        if minutos_diff > 6:
            huecos += 1
            print(f"Salto detectado: de {fechas_dt[i-1]} a {fechas_dt[i]} ({minutos_diff:.1f} minutos sin datos)")

    if huecos == 0:
        print("¡Todo joya, lince! No hay cortes, tenés un dato cada 5 minutos de corrido.")
    else:
        print(f"\nResumen de errores: Se encontraron {huecos} cortes en la transmisión de datos.")

if __name__ == "__main__":
    # Apuntá al archivo mensual
    archivo = 'data/maiatec_2026_10.json'
    generar_resumen(archivo)